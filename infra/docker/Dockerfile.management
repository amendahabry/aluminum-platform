FROM python:3.11-slim
WORKDIR /app
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1

COPY backend/requirements.txt /app/backend/
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

COPY backend/shared /app/backend/shared
COPY backend/services/management_service /app/backend/services/management_service
COPY backend/services/orders_service /app/backend/services/orders_service
COPY backend/services/inventory_service /app/backend/services/inventory_service
COPY backend/services/production_service /app/backend/services/production_service

EXPOSE 8006
CMD ["uvicorn", "services.management_service.main:app", "--host", "0.0.0.0", "--port", "8006"]
