# Aluminum Management System - root .env.example
# Copy to .env and adjust for local/dev

# JWT (must match across auth + gateway in production)
JWT_SECRET_KEY=change-me-in-production-use-long-secret
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Database (shared by auth, inventory, orders)
DATABASE_URL=postgresql://aluminum:aluminum@localhost:5432/aluminum

# Redis (Celery + cache)
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aluminum

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Log level
LOG_LEVEL=INFO
